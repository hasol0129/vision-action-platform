# cp .env.example .env 후 값을 바꿔서 사용. .env는 Git에 올리지 않는다

# --- Docker Compose ---
# 컨테이너·볼륨 이름 앞에 붙는 이름. 같은 PC에서 두 벌을 동시에 띄울 때만 바꾼다
COMPOSE_PROJECT_NAME=vision_action_platform

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 브라우저에서 접속할 포트 (8000을 다른 프로그램이 쓰면 바꾸고 위 CSRF 주소도 같이 변경)
DJANGO_PORT=8000
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=100

# --- PostgreSQL (postgres 서비스와 django·celery가 함께 사용) ---
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- FastAPI AI 추론 서버 ---
FASTAPI_URL=http://fastapi:8001
FASTAPI_TIMEOUT=300
# PC에서 Swagger(/docs)를 열 포트 (8001을 다른 프로그램이 쓰면 변경)
FASTAPI_PORT=8001
MODEL_DIR=/app/models
# confidence가 이 값보다 낮으면 '판단 불확실'로 표시 (모델 출력값은 바뀌지 않음)
UNCERTAIN_THRESHOLD=0.4

# --- IP Webcam: 허용할 카메라만 key=URL 형태로 등록 (사용자는 key만 선택) ---
# 예: phone1=http://<휴대폰 IP>:8080/video
ALLOWED_CAMERA_URLS=phone1=http://192.168.0.10:8080/video
CAMERA_CAPTURE_SECONDS=8
# 휴대폰을 옆으로 세워 영상이 누워 보이면 90 또는 270
CAMERA_ROTATE=0
CAMERA_OPEN_TIMEOUT_SEC=10
